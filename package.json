{
  "name": "fullstack-cf-project-template",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:worker": "bun --filter fullstack-cf-project-template-worker dev",
    "dev:web": "bun --filter fullstack-cf-project-template-web dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun --filter fullstack-cf-project-template-worker typecheck && bun --filter fullstack-cf-project-template-web typecheck",
    "ci": "bun run lint && bun run format:check && bun run typecheck",
    "deploy:worker": "bun --filter fullstack-cf-project-template-worker run deploy",
    "deploy:web": "bun --filter fullstack-cf-project-template-web run deploy",
    "deploy": "bun run deploy:worker && bun run deploy:web"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest"
  }
}
