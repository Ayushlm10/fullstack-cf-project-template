# Cloudflare Worker Environment Variables
# Copy this file to .env and fill in your actual values
# Note: .env files are for local development only and are gitignored

# --------------------------------------------------
# API Keys & Secrets
# --------------------------------------------------
# Use 'wrangler secret put' for production secrets
# Example: wrangler secret put API_KEY

# Example API key
# API_KEY=your-api-key-here

# Example third-party service credentials
# STRIPE_SECRET_KEY=sk_test_...
# OPENAI_API_KEY=sk-...

# --------------------------------------------------
# Database & Storage
# --------------------------------------------------
# Note: Cloudflare bindings (KV, D1, R2) are configured in wrangler.jsonc
# These are just example environment variables for external services

# External database URL (if not using D1)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis/Upstash (if using external caching)
# REDIS_URL=redis://...

# --------------------------------------------------
# Feature Flags
# --------------------------------------------------
# ENABLE_DEBUG_LOGGING=false
# ENABLE_ANALYTICS=true

# --------------------------------------------------
# CORS Configuration
# --------------------------------------------------
# Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --------------------------------------------------
# Development/Testing
# --------------------------------------------------
# Environment identifier
# ENVIRONMENT=development
