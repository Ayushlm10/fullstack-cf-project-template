# Web App Environment Variables
# Copy this file to .env and fill in your actual values
# Note: .env files are for local development only and are gitignored

# --------------------------------------------------
# API Configuration
# --------------------------------------------------
# Worker API URL (for production deployment)
# LOCAL: Uses service binding automatically (no need to set)
# PRODUCTION: Set your deployed worker URL
# VITE_API_URL=https://your-worker.your-subdomain.workers.dev

# --------------------------------------------------
# Public Environment Variables
# --------------------------------------------------
# Variables prefixed with VITE_ are exposed to the client-side code
# Be careful not to expose secrets here!

# App Configuration
# VITE_APP_NAME=My App
# VITE_APP_VERSION=1.0.0

# Feature Flags (client-side)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG=false

# --------------------------------------------------
# Third-Party Services (Public Keys Only!)
# --------------------------------------------------
# Analytics (client-safe public keys)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_POSTHOG_KEY=phc_...
# VITE_SENTRY_DSN=https://...

# Maps & Location
# VITE_GOOGLE_MAPS_API_KEY=...
# VITE_MAPBOX_TOKEN=...

# Authentication (public client IDs only)
# VITE_AUTH0_DOMAIN=your-domain.auth0.com
# VITE_AUTH0_CLIENT_ID=...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --------------------------------------------------
# Build Configuration
# --------------------------------------------------
# VITE_BUILD_MODE=production

# --------------------------------------------------
# Development
# --------------------------------------------------
# Environment identifier
# VITE_ENVIRONMENT=development

# --------------------------------------------------
# IMPORTANT SECURITY NOTES
# --------------------------------------------------
# 1. NEVER put secret keys in VITE_ variables - they're exposed to the browser!
# 2. For server-side secrets, use the worker's .env file instead
# 3. Use wrangler secrets for production: wrangler secret put SECRET_NAME
# 4. Public keys (client IDs, publishable keys) are safe to use with VITE_
